# Functiebeschrijvingen
func.DAGMIN=DAGMIN([kolom]) - minimum per dag
func.DAGMAX=DAGMAX([kolom]) - maximum per dag
func.DAGSOM=DAGSOM([kolom]) - totaal per dag
func.DAGGEM=DAGGEM([kolom]) - gemiddelde per dag
func.SUM=SUM(a; b; ...) - som per rij (SOM)
func.SUBTRACT=SUBTRACT(a; b; ...) - trek waarden per rij van elkaar af (AFTREKKEN)
func.PRODUCT=PRODUCT(a; b; ...) - vermenigvuldig waarden per rij (MULTIPLY)
func.DIVIDE=DIVIDE(a; b; ...) - deel waarden per rij achtereenvolgens (DELEN)
func.MIN=MIN(a; b; ...) - minimum per rij
func.MAX=MAX(a; b; ...) - maximum per rij
func.AVERAGE=AVERAGE(a; b; ...) - gemiddelde per rij (GEMIDDELDE)
func.IF=IF(voorwaarde; dan; anders) (ALS)
func.AND=AND(a; b; ...) (EN)
func.OR=OR(a; b; ...) (OF)
func.NOT=NOT(a) (NIET)
func.ABS=ABS(x)
func.SQRT=SQRT(x) (WORTEL)
func.ROUND=ROUND(x; decimalen) (AFRONDEN)
func.INT=INT(x) - naar beneden afronden (HELE)
func.POWER=POWER(x; y) of x^y (MACHT)
func.MOD=MOD(x; y) (REST)
func.LN=LN(x)
func.LOG10=LOG10(x)
func.EXP=EXP(x)
func.SIN=SIN(x) - radialen
func.COS=COS(x) - radialen
func.TAN=TAN(x) - radialen
func.RADIANS=RADIANS(graden)
func.DEGREES=DEGREES(radialen)
func.DIFF=DIFF(x) - verschil met vorige rij (VERSCHIL)
func.ROLLAVG=ROLLAVG(x; n) - voortschrijdend gemiddelde over n rijen (GLIJDEND)
func.STAP=STAP() - tijdstap van de data in uren
func.DERIVATIVE=DERIVATIVE(x; eenheid) - afgeleide per tijdseenheid: SEC, MIN, UUR of DAG (AFGELEIDE)
func.INTEGRAL=INTEGRAL(x; eenheid) - lopende integraal over de tijd: SEC, MIN, UUR of DAG (INTEGRAAL)
func.UUR=UUR() - tijdstip van de rij als decimaal uur (0-24)
func.ZONOP=ZONOP(breedte; lengte; utc-verschil) - zonsopkomst in decimaal uur
func.ZONONDER=ZONONDER(breedte; lengte; utc-verschil) - zonsondergang in decimaal uur
funcdef.header=# Eigen functies en constanten (worden voor alle loggers geladen)\n# Constante:  NAAM = waarde of formule\n# Functie:    NAAM(param1; param2) = formule   (parameters als [param1] of param1)\n
