# Functiebeschrijvingen
func.SUM=SUM(a; b; ...) - som per rij (SOM)
func.SUBTRACT=SUBTRACT(a; b; ...) - trek waarden per rij van elkaar af (AFTREKKEN)
func.PRODUCT=PRODUCT(a; b; ...) - vermenigvuldig waarden per rij (MULTIPLY)
func.DIVIDE=DIVIDE(a; b; ...) - deel waarden per rij achtereenvolgens (DELEN)
func.MIN=MIN(a; b; ...) - minimum per rij
func.MAX=MAX(a; b; ...) - maximum per rij
func.AVERAGE=AVERAGE(a; b; ...) - gemiddelde per rij (GEMIDDELDE)
func.IF=IF(voorwaarde; dan; anders) (ALS)
func.AND=AND(a; b; ...) (EN)
func.OR=OR(a; b; ...) (OF)
func.NOT=NOT(a) (NIET)
func.ABS=ABS(x)
func.SQRT=SQRT(x) (WORTEL)
func.ROUND=ROUND(x; decimalen) (AFRONDEN)
func.INT=INT(x) - naar beneden afronden (HELE)
func.POWER=POWER(x; y) of x^y (MACHT)
func.MOD=MOD(x; y) (REST)
func.LN=LN(x)
func.LOG10=LOG10(x)
func.EXP=EXP(x)
func.SIN=SIN(x) - radialen
func.COS=COS(x) - radialen
func.TAN=TAN(x) - radialen
func.RADIANS=RADIANS(graden)
func.DEGREES=DEGREES(radialen)
func.DIFF=DIFF(x) - verschil met vorige rij (VERSCHIL)
func.ROLLAVG=ROLLAVG(x; n) - voortschrijdend gemiddelde over n rijen (GLIJDEND)
func.STEP=STEP() - tijdstap van de data in uren (STAP)
func.DERIVATIVE=DERIVATIVE(x; eenheid) - afgeleide per tijdseenheid: SECOND, MINUTE, HOUR of DAY (AFGELEIDE)
func.INTEGRAL=INTEGRAL(x; eenheid) - lopende integraal over de tijd: SECOND, MINUTE, HOUR of DAY (INTEGRAAL)
func.FIRST_DERIVATIVE=FIRST_DERIVATIVE(x; eenheid) - eerste afgeleide per tijdseenheid (EERSTE_AFGELEIDE)
func.SECOND_DERIVATIVE=SECOND_DERIVATIVE(x; eenheid) - tweede afgeleide per tijdseenheid (TWEEDE_AFGELEIDE)
func.CUMULATIVE_INTEGRAL=CUMULATIVE_INTEGRAL(x; eenheid) - cumulatieve trapeziumintegraal (CUMULATIEVE_INTEGRAAL)
func.INTEGRAL_DEVIATION=INTEGRAL_DEVIATION(x; eenheid) - cumulatieve integraal van x minus het gemiddelde (INTEGRAAL_VAN_AFWIJKING)
func.UUR=UUR() - tijdstip van de rij als decimaal uur (0-24)
func.SUNUP=SUNUP(breedte; lengte; utc-verschil) - zonsopkomst in decimaal uur (ZONOP)
func.SUNDOWN=SUNDOWN(breedte; lengte; utc-verschil) - zonsondergang in decimaal uur (ZONONDER)
funcdef.header=# Eigen functies en constanten (worden voor alle loggers geladen)\n# Constante:  NAAM @ Groep = waarde of formule\n# Functie:    NAAM(param1; param2) @ Groep = formule   (parameters als [param1] of param1)\n

