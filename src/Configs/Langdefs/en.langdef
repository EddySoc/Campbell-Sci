# Function descriptions
func.SUM=SUM(a; b; ...) - sum per row
func.SUBTRACT=SUBTRACT(a; b; ...) - subtract values per row
func.PRODUCT=PRODUCT(a; b; ...) - multiply values per row
func.DIVIDE=DIVIDE(a; b; ...) - divide values per row successively
func.MIN=MIN(a; b; ...) - minimum per row
func.MAX=MAX(a; b; ...) - maximum per row
func.AVERAGE=AVERAGE(a; b; ...) - mean per row
func.IF=IF(condition; then; else)
func.AND=AND(a; b; ...)
func.OR=OR(a; b; ...)
func.NOT=NOT(a)
func.ABS=ABS(x)
func.SQRT=SQRT(x)
func.ROUND=ROUND(x; decimals)
func.INT=INT(x) - round down
func.POWER=POWER(x; y) or x^y
func.MOD=MOD(x; y)
func.LN=LN(x)
func.LOG10=LOG10(x)
func.EXP=EXP(x)
func.SIN=SIN(x) - radians
func.COS=COS(x) - radians
func.TAN=TAN(x) - radians
func.RADIANS=RADIANS(degrees)
func.DEGREES=DEGREES(radians)
func.DIFF=DIFF(x) - difference with previous row
func.ROLLAVG=ROLLAVG(x; n) - rolling mean over n rows
func.STEP=STEP() - time step of the data in hours (STAP)
func.DERIVATIVE=DERIVATIVE(x; unit) - derivative per time unit: SECOND, MINUTE, HOUR or DAY
func.INTEGRAL=INTEGRAL(x; unit) - running integral over time: SECOND, MINUTE, HOUR or DAY
func.FIRST_DERIVATIVE=FIRST_DERIVATIVE(x; unit) - first derivative per time unit
func.SECOND_DERIVATIVE=SECOND_DERIVATIVE(x; unit) - second derivative per time unit
func.CUMULATIVE_INTEGRAL=CUMULATIVE_INTEGRAL(x; unit) - cumulative trapezoidal integral over time
func.INTEGRAL_DEVIATION=INTEGRAL_DEVIATION(x; unit) - cumulative integral of x minus its mean
func.UUR=UUR() - time of the row as decimal hour (0-24)
func.SUNUP=SUNUP(latitude; longitude; utc offset) - sunrise in decimal hours (ZONOP)
func.SUNDOWN=SUNDOWN(latitude; longitude; utc offset) - sunset in decimal hours (ZONONDER)
funcdef.header=# Custom functions and constants (loaded for all loggers)\n# Constant:  NAME @ Group = value or formula\n# Function:  NAME(param1; param2) @ Group = formula   (parameters as [param1] or param1)\n

