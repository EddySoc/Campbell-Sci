# name;type;columns;minimum;maximum;number format;tab color
# type=windroos: first column = wind direction; optional extra columns = concentrations (mean per direction); omit the line for loggers without a windrose.
# tab color: hex code or a readable color name
# optional eighth field: linear (scatter trendline)
Batterij;line;TIMESTAMP,batt_volt_Min;;;0.0;gray
Temp;line;TIMESTAMP,PTemp_Avg;;;0.0;
O3;line;TIMESTAMP,O3_Avg,O3_Std,Wind_Dir_WVT@secondary;;;0.0;
NOx Avg;line;TIMESTAMP,AVG_NO,AVG_NO2,Hoogte@secondary;;;0.0;
Nox Std;line;TIMESTAMP,STD_NO,STD_NO2,Hoogte@secondary;;;0.0;
Vgl O3 Nox;line;TIMESTAMP,AVG_NO,AVG_NO2,Hoogte@secondary;;;0.0;
wind dir;windroos;Wind_Dir_WVT;;;0.0;
vgl O3-WindDir;windroos;Wind_Dir_WVT,O3 Abs,NO2 Abs;;;0.0;
